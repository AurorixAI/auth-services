          "ok"
        ],
        "title": "LessonMoveCheckOut",
        "type": "object"
      },
      "LessonMoveRequest": {
        "description": "#124: the administrator moves a future lesson straight from the lesson sheet (no request of a teacher needed).  Same fields and rules as the decision\n``reschedule``; ``expectedStartTime`` / ``expectedEndTime`` are what the sheet showed (409 ``LESSON_CHANGED`` when the schedule moved meanwhile).",
        "properties": {
          "endTime": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Endtime"
          },
          "expectedEndTime": {
            "anyOf": [
              {
                "pattern": "^\\d{2}:\\d{2}$",
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Expectedendtime"
          },
          "expectedStartTime": {
            "anyOf": [
              {
                "pattern": "^\\d{2}:\\d{2}$",
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Expectedstarttime"
          },
          "format": {
            "anyOf": [
              {
                "enum": [
                  "offline",
                  "online"
                ],
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Format"
          },
          "lessonDate": {
            "format": "date",
            "title": "Lessondate",
            "type": "string"
          },
          "lessonId": {
            "maxLength": 100,
            "minLength": 1,
            "title": "Lessonid",
            "type": "string"
          },
          "newDate": {
            "anyOf": [
              {
                "format": "date",
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Newdate"
