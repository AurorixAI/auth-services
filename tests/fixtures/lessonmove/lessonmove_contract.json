  "info": {
    "title": "ALGO auth - lesson sheet moves (#124)",
    "version": "lessonmove-4"
  },
  "openapi": "3.1.0",
  "paths": {
    "/org/groups/{group_id}/lesson-exam-binding": {
      "get": {
        "description": "Предпроверка «Отменить урок» для листа урока (экзамен, привязанный к уроку): `canCancel=false` — активный экзамен; тот же ответ, что `examBinding` диалога «Замены».",
        "parameters": [
          {
            "in": "path",
            "name": "group_id",
            "required": true,
            "schema": {
              "title": "Group Id",
              "type": "string"
            }
          },
          {
            "in": "query",
            "name": "lessonId",
            "required": true,
            "schema": {
              "maxLength": 100,
              "minLength": 1,
              "title": "Lessonid",
              "type": "string"
            }
          },
          {
            "in": "query",
            "name": "lessonDate",
            "required": true,
            "schema": {
              "format": "date",
              "title": "Lessondate",
              "type": "string"
            }
          }
        ],
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/LessonExamBinding"
                }
              }
            },
            "description": "Successful Response"
          },
          "422": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            },
            "description": "Validation Error"
          }
        },
        "security": [
          {
            "HTTPBearer": []
          }
        ],
        "summary": "Lesson Exam Binding",
        "tags": [
          "Authentication",
          "LOGIC-B2 substitutions"
        ],
        "x-errors": [
          {
            "message": "Недостаточно прав. Требуется: owner, admin",
            "status": 403
          },
          {
            "code": "GROUP_NOT_FOUND",
            "message": "Группа не найдена",
            "status": 404
          },
          {
            "code": "LESSON_NOT_FOUND",
            "message": "Урок не найден",
            "status": 404
          }
        ]
      }
    },
    "/org/groups/{group_id}/lesson-move": {
      "post": {
        "description": "Администратор - или преподаватель, который ведёт этот урок (не позднее чем за 60 минут до начала) - переносит будущий урок прямо из листа урока: правила и\nпроверки решения «Перенести урок»; открытый запрос урока решается тем же путём.",
        "parameters": [
          {
            "in": "path",
            "name": "group_id",
            "required": true,
            "schema": {
              "title": "Group Id",
              "type": "string"
            }
          }
        ],
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/LessonMoveRequest"
              }
            }
          },
          "required": true
        },
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/DecideOut"
                }
              }
            },
            "description": "Successful Response"
          },
          "422": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            },
            "description": "Validation Error"
          }
        },
        "security": [
          {
            "HTTPBearer": []
          }
        ],
        "summary": "Move Lesson Directly",
        "tags": [
          "Authentication",
          "LOGIC-B2 substitutions"
        ],
        "x-errors": [
          {
            "message": "Перенести урок может преподаватель группы или администратор",
            "status": 403
          },
          {
            "code": "GROUP_NOT_FOUND",
            "message": "Группа не найдена",
            "status": 404
          },
          {
            "code": "LESSON_NOT_FOUND",
            "message": "Урок не найден",
            "status": 404
          },
          {
            "code": "GROUP_ARCHIVED",
            "message": "Группа в архиве: действие недоступно",
            "status": 409
          },
          {
            "code": "LESSON_CANCELLED",
            "message": "Урок отменён",
            "status": 409
          },
          {
            "code": "LESSON_ALREADY_STARTED",
            "message": "Урок уже начался или прошёл. Обратитесь к администратору",
            "status": 409
          },
          {
            "code": "LESSON_CHANGED",
            "message": "Расписание урока изменилось: обновите страницу и повторите",
            "status": 409
          },
          {
            "code": "SUBSTITUTION_ALREADY_DECIDED",
            "message": "Запрос уже решён",
            "status": 409
          },
          {
            "code": "GROUP_BUSY",
            "message": "У группы уже есть урок в это время",
            "status": 409
          },
          {
            "code": "TEACHER_BUSY",
            "message": "У преподавателя в это время другой урок (conflicts, total)",
            "status": 409
          },
          {
            "code": "LESSON_HAS_LIVE_EXAM",
            "message": "Нельзя перенести урок с активным экзаменом (текст exam-service)",
            "status": 409
          },
          {
            "code": "EXAM_SERVICE_UNAVAILABLE",
            "message": "Не удалось проверить экзамены группы. Повторите попытку.",
            "status": 503
          },
          {
            "code": "REASON_REQUIRED",
            "message": "Укажите причину (не менее 3 символов)",
            "status": 422
          },
          {
            "code": "MOVE_FIELDS_REQUIRED",
            "message": "Укажите новую дату и время урока",
            "status": 422
          },
          {
            "code": "MOVE_IN_PAST",
            "message": "Новое время урока уже прошло",
            "status": 422
          },
          {
            "code": "MOVE_TOO_FAR",
            "message": "Перенести можно не дальше чем на 60 дней",
            "status": 422
          },
          {
            "code": "MOVE_SAME_SLOT",
            "message": "Выберите другую дату или время",
            "status": 422
          },
          {
            "code": "LESSON_HAS_NO_TEACHER",
            "message": "У группы нет преподавателя — назначьте его в карточке группы",
            "status": 422
          },
          {
            "code": "NOT_LESSON_TEACHER",
            "message": "Перенести урок может преподаватель группы или администратор",
            "status": 403
          },
          {
            "code": "MOVE_TOO_LATE",
            "message": "Перенести урок можно не позднее чем за 60 минут до начала. Нажмите «Не смогу провести» — решит администратор",
            "status": 409
          },
          {
            "code": "FOREIGN_REQUEST_PENDING",
            "message": "По этому уроку есть запрос другого преподавателя: решит администратор",
            "status": 409
          },
          {
            "code": "REASON_TOO_LONG",
            "message": "Причина не длиннее 500 символов",
            "status": 422
          }
        ]
      }
    },
    "/org/groups/{group_id}/lesson-move-check": {
      "get": {
        "description": "Живая проверка переноса урока без запроса: пересечения учителя нового урока и группы (преподаватель - только для своего урока).",
        "parameters": [
          {
            "in": "path",
            "name": "group_id",
            "required": true,
            "schema": {
              "title": "Group Id",
              "type": "string"
            }
          },
          {
            "in": "query",
            "name": "lessonId",
            "required": true,
            "schema": {
              "maxLength": 100,
              "minLength": 1,
              "title": "Lessonid",
              "type": "string"
            }
          },
          {
            "in": "query",
            "name": "lessonDate",
            "required": true,
            "schema": {
              "format": "date",
              "title": "Lessondate",
              "type": "string"
            }
          },
          {
            "in": "query",
            "name": "newDate",
            "required": true,
            "schema": {
              "format": "date",
              "title": "Newdate",
              "type": "string"
            }
          },
          {
            "in": "query",
            "name": "startTime",
            "required": true,
            "schema": {
              "pattern": "^\\d{2}:\\d{2}$",
              "title": "Starttime",
              "type": "string"
            }
          },
          {
            "in": "query",
            "name": "endTime",
            "required": true,
            "schema": {
              "pattern": "^\\d{2}:\\d{2}$",
              "title": "Endtime",
              "type": "string"
            }
          }
        ],
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/LessonMoveCheckOut"
                }
              }
            },
            "description": "Successful Response"
          },
          "422": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            },
            "description": "Validation Error"
          }
        },
        "security": [
          {
            "HTTPBearer": []
          }
        ],
        "summary": "Lesson Move Check",
        "tags": [
          "Authentication",
          "LOGIC-B2 substitutions"
        ],
        "x-errors": [
