  "info": {
    "title": "ALGO auth - lesson sheet moves (#124)",
    "version": "lessonmove-1"
  },
  "openapi": "3.1.0",
  "paths": {
    "/org/groups/{group_id}/lesson-exam-binding": {
      "get": {
        "description": "Предпроверка «Отменить урок» для листа урока (экзамен, привязанный к уроку): `canCancel=false` — активный экзамен; тот же ответ, что `examBinding` диалога «Замены».",
        "parameters": [
          {
            "in": "path",
            "name": "group_id",
            "required": true,
            "schema": {
              "title": "Group Id",
              "type": "string"
            }
          },
          {
            "in": "query",
            "name": "lessonId",
            "required": true,
            "schema": {
              "maxLength": 100,
              "minLength": 1,
              "title": "Lessonid",
              "type": "string"
            }
          },
          {
            "in": "query",
            "name": "lessonDate",
            "required": true,
            "schema": {
              "format": "date",
              "title": "Lessondate",
              "type": "string"
            }
          }
        ],
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/LessonExamBinding"
                }
              }
            },
            "description": "Successful Response"
          },
          "422": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            },
            "description": "Validation Error"
          }
        },
        "security": [
          {
            "HTTPBearer": []
          }
        ],
        "summary": "Lesson Exam Binding",
        "tags": [
          "Authentication",
          "LOGIC-B2 substitutions"
        ],
        "x-errors": [
          {
            "message": "Нет доступа (только владелец и администратор центра)",
            "status": 403
          },
          {
            "code": "GROUP_NOT_FOUND",
            "message": "Группа не найдена",
            "status": 404
          },
          {
            "code": "LESSON_NOT_FOUND",
            "message": "Урок не найден",
            "status": 404
          }
        ]
      }
    },
    "/org/groups/{group_id}/lesson-move": {
      "post": {
        "description": "Администратор переносит будущий урок прямо из листа урока: правила и проверки решения «Перенести урок»; открытый запрос урока решается тем же путём.",
        "parameters": [
          {
            "in": "path",
            "name": "group_id",
            "required": true,
            "schema": {
              "title": "Group Id",
              "type": "string"
            }
          }
        ],
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/LessonMoveRequest"
              }
            }
          },
          "required": true
        },
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/DecideOut"
                }
              }
            },
            "description": "Successful Response"
          },
          "422": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            },
            "description": "Validation Error"
          }
        },
        "security": [
          {
            "HTTPBearer": []
