                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Room"
          },
          "startTime": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Starttime"
          }
