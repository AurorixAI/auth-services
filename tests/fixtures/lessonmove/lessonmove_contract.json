  "x-additive": [
    {
      "audience": "everybody who sees the schedule (#124)",
      "endpoint": "GET /org/schedule/occurrences",
      "field": "movedFrom",
      "schema": "MovedFrom|null"
    },
    {
      "audience": "everybody who reads the journal (#124)",
      "endpoint": "GET /org/groups/{id}/attendance",
      "field": "lessons[].movedFrom",
      "schema": "MovedFrom (only on a moved lesson)"
    },
    {
      "audience": "manager (#124)",
      "endpoint": "GET /org/students/{id}/attendance",
      "field": "lessons[].movedFrom",
      "schema": "MovedFrom (only on a moved lesson)"
    },
    {
      "audience": "manager (R3 #6: ok=false because of the origin lesson)",
      "endpoint": "GET /org/groups/{group_id}/lesson-move-check",
      "field": "code",
      "schema": "string|null"
    },
    {
      "audience": "manager (R3 #6: the text POST lesson-move would answer)",
      "endpoint": "GET /org/groups/{group_id}/lesson-move-check",
      "field": "message",
      "schema": "string|null"
    },
    {
      "audience": "everybody who reads the decision: the teacher moved HIS lesson (P1.1)",
      "endpoint": "POST /org/groups/{group_id}/lesson-move",
      "field": "item.decision.via",
      "schema": "'teacher_move' (a new value of the enum)"
    },
    {
      "audience": "manager (P1.1)",
      "endpoint": "GET /org/substitutions/{id}",
      "field": "events[].snapshot.trigger",
      "schema": "'teacher_move' (the record of a teacher's move; 'manager_move' for the administrator's)"
    },
    {
      "audience": "manager (P1.1)",
      "endpoint": "GET /org/substitutions/{id}",
      "field": "events[].snapshot.via",
      "schema": "'request' | 'teacher_move' (event 'rescheduled')"
    },
    {
      "audience": "teacher (P1.1)",
      "endpoint": "GET /org/groups/{group_id}/lesson-move-check",
      "field": "(access)",
      "schema": "teacher of THIS lesson (403 NOT_LESSON_TEACHER otherwise)"
    }
  ]
}
