          "canCancel": {
            "default": true,
            "title": "Cancancel",
            "type": "boolean"
          },
          "message": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Message"
          },
          "state": {
            "default": "none",
            "enum": [
              "ok",
              "none",
              "unavailable"
            ],
            "title": "State",
            "type": "string"
          },
          "title": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Title"
          }
        },
        "title": "LessonExamBinding",
        "type": "object"
      },
      "LessonMoveCheckOut": {
        "description": "#124 ``lesson-move-check`` = ``MoveCheckOut`` (the frozen B2 shape of the request check) + the refusal of the ORIGIN lesson (R3 #6): ``ok = false`` with\n``code`` / ``message`` when POST ``lesson-move`` would refuse the lesson itself (started, cancelled, archived group, already decided, no teacher); both null otherwise.",
