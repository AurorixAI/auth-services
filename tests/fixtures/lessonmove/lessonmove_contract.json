          "canCancel": {
            "default": true,
            "title": "Cancancel",
            "type": "boolean"
          },
          "message": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Message"
          },
          "state": {
            "default": "none",
            "enum": [
              "ok",
              "none",
