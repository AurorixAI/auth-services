  "info": {
    "title": "ALGO auth - INCOME-2 contract",
    "version": "income2-1"
  },
  "openapi": "3.1.0",
  "paths": {
    "/org/payments/income": {
      "get": {
        "description": "Страница «Поступления» над журналом: четыре цифры периода с сравнением с предыдущим таким же, фраза-вывод, «куда ушли\nденьги», способы, ряд по дням (каждый день есть, с нулями), наличные за день, «Собрано за месяц» по группам (только месяц).",
        "parameters": [
          {
            "in": "query",
            "name": "from",
            "required": true,
            "schema": {
              "format": "date",
              "title": "From",
              "type": "string"
            }
          },
          {
            "in": "query",
            "name": "to",
            "required": true,
            "schema": {
              "format": "date",
              "title": "To",
              "type": "string"
            }
          },
          {
            "description": "Вид периода; без него определяется по датам (один день / 7 дней с понедельника / целый месяц / свой)",
            "in": "query",
            "name": "period",
            "required": false,
            "schema": {
              "anyOf": [
                {
                  "enum": [
                    "day",
                    "week",
                    "month",
                    "custom"
                  ],
                  "type": "string"
                },
                {
                  "type": "null"
                }
              ],
              "description": "Вид периода; без него определяется по датам (один день / 7 дней с понедельника / целый месяц / свой)",
              "title": "Period"
            }
          },
          {
            "in": "query",
            "name": "method",
            "required": false,
            "schema": {
              "anyOf": [
                {
                  "type": "string"
                },
                {
                  "type": "null"
                }
              ],
              "title": "Method"
            }
          },
          {
            "in": "query",
            "name": "group_id",
            "required": false,
            "schema": {
              "anyOf": [
                {
                  "format": "uuid",
                  "type": "string"
                },
                {
                  "type": "null"
                }
              ],
              "title": "Group Id"
            }
          },
          {
            "in": "query",
            "name": "teacher_id",
            "required": false,
            "schema": {
              "anyOf": [
                {
                  "format": "uuid",
                  "type": "string"
                },
                {
                  "type": "null"
                }
              ],
              "title": "Teacher Id"
            }
          }
        ],
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/IncomeOverview"
                }
              }
            },
            "description": "Successful Response"
          },
          "403": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/PayError"
                }
              }
            },
            "description": "Forbidden"
          },
          "422": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/PayError"
                }
              }
            },
            "description": "Unprocessable Entity"
          }
        },
        "security": [
          {
            "HTTPBearer": []
          }
        ],
        "summary": "Income Overview",
        "tags": [
          "Payments",
          "Payments"
        ],
        "x-errors": [
          {
            "message": "Нет доступа к оплатам",
            "status": 403
          },
          {
            "code": "INVALID_PERIOD",
            "message": "Конец периода раньше начала | День — это один день | Неделя — это семь дней | Месяц начинается с первого числа и не выходит за свой месяц",
            "status": 422
          },
          {
            "code": "RANGE_TOO_LONG",
            "message": "Период не длиннее 366 дней",
            "status": 422
          }
        ]
      }
    },
    "/org/payments/journal": {
