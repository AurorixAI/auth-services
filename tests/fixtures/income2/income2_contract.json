                "all",
                "active",
                "voided"
              ],
              "title": "Status",
              "type": "string"
            }
          }
        ],
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/PaymentsJournal"
                }
              }
            },
            "description": "Successful Response"
          },
          "403": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/PayError"
                }
              }
            },
            "description": "Forbidden"
          },
          "422": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/PayError"
                }
              }
            },
            "description": "Unprocessable Entity"
          }
        },
        "security": [
          {
            "HTTPBearer": []
          }
        ],
        "summary": "Payments Journal",
        "tags": [
          "Payments",
          "Payments"
        ],
        "x-errors": [
          {
            "message": "Нет доступа к оплатам",
            "status": 403
          },
          {
            "code": "INVALID_PERIOD",
            "message": "Конец периода раньше начала | День — это один день | Неделя — это семь дней | Месяц начинается с первого числа и не выходит за свой месяц",
            "status": 422
          },
          {
            "code": "RANGE_TOO_LONG",
            "message": "Период не длиннее 366 дней",
            "status": 422
          }
        ]
      }
    },
