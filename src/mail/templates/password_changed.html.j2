{% extends "_layout.html.j2" %}
{% from "_macros.html.j2" import p, small %}
{% block preheader %}Пароль вашей учётной записи изменён.{% endblock %}
{% block title %}Пароль изменён{% endblock %}
{% block content %}
{% call p() %}{% if greeting %}Здравствуйте, {{ greeting }}!{% else %}Здравствуйте!{% endif %}{% endcall %}
{% call p() %}Пароль вашей учётной записи ALGO изменён{% if changed_text %} ({{ changed_text }}, по Ташкенту){% endif %}. Все прежние входы закрыты — войдите с новым паролем.{% endcall %}
{% call small() %}Если это были не вы — сразу напишите на <a class="link" href="mailto:{{ support_email }}" style="color:#2563eb;">{{ support_email }}</a>, мы поможем закрыть доступ.{% endcall %}
{% endblock %}
{% block footer_reason %}Вы получили это письмо, потому что у вашей учётной записи ALGO изменён пароль.{% endblock %}
