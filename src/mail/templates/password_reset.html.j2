{% extends "_layout.html.j2" %}
{% from "_macros.html.j2" import p, small, button, url_fallback %}
{% block preheader %}Ссылка для смены пароля действует один час.{% endblock %}
{% block title %}Сброс пароля{% endblock %}
{% block content %}
{% call p() %}{% if greeting %}Здравствуйте, {{ greeting }}!{% else %}Здравствуйте!{% endif %}{% endcall %}
{% if kind == "staff" %}
{% call p() %}{{ initiator_text }} центра <strong class="ink" style="color:#0f172a;">«{{ centre_name }}»</strong>{% if initiator_name %} ({{ initiator_name }}){% endif %} отправил вам ссылку для смены пароля в ALGO{% if email %} (учётная запись <strong class="ink" style="color:#0f172a;">{{ email }}</strong>){% endif %}. Пароль не изменится, пока вы сами не зададите новый; до этого вы входите со старым.{% endcall %}
{% elif kind == "self" %}
{% call p() %}Для учётной записи{% if email %} <strong class="ink" style="color:#0f172a;">{{ email }}</strong>{% endif %} запрошена смена пароля на странице входа в ALGO{% if requested_text %} ({{ requested_text }}, по Ташкенту){% endif %}. Нажмите кнопку, чтобы задать новый.{% endcall %}
{% else %}
{% call p() %}Для вашей учётной записи{% if email %} <strong class="ink" style="color:#0f172a;">{{ email }}</strong>{% endif %} запрошена смена пароля в ALGO. Нажмите кнопку, чтобы задать новый.{% endcall %}
{% endif %}
{{ button(cta_url, "Задать новый пароль") }}
{% call small() %}Ссылка действует {{ expires_phrase }}{% if expires_text %} — до {{ expires_text }} (по Ташкенту){% endif %} и открывается один раз. После смены пароля все прежние входы будут закрыты.{% endcall %}
{% call small() %}{% if kind == "self" %}Если вы не запрашивали смену пароля — просто проигнорируйте это письмо, пароль останется прежним.{% else %}Если вам не нужна смена пароля — просто проигнорируйте это письмо, пароль останется прежним.{% endif %}{% endcall %}
{{ url_fallback(cta_url) }}
{% endblock %}
{% block footer_reason %}Вы получили это письмо, потому что для вашей учётной записи ALGO запрошена смена пароля.{% endblock %}
