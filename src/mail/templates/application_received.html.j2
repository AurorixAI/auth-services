{% extends "_layout.html.j2" %}
{% from "_macros.html.j2" import p, small %}
{% block preheader %}Мы получили вашу заявку на доступ к ALGO и скоро свяжемся с вами.{% endblock %}
{% block title %}Заявка получена{% endblock %}
{% block content %}
{% call p() %}{% if greeting %}Здравствуйте, {{ greeting }}!{% else %}Здравствуйте!{% endif %}{% endcall %}
{% call p() %}Благодарим за интерес к ALGO. Мы получили заявку на доступ для центра <strong class="ink" style="color:#0f172a;">«{{ centre_name }}»</strong>.{% endcall %}
{% call p() %}ALGO открывается по приглашению: мы лично знакомимся с каждым центром, чтобы платформа сразу подошла вашей работе. <strong class="ink" style="color:#0f172a;">Менеджер свяжется с вами в течение 1–2 рабочих дней.</strong>{% endcall %}

<table role="presentation" width="100%" cellpadding="0" cellspacing="0" border="0" class="panel" style="margin:24px 0 20px 0;background-color:#f8fafc;border:1px solid #e2e8f0;border-radius:16px;">
  <tr><td style="padding:22px 24px 6px 24px;font-family:Inter,-apple-system,'Segoe UI',Roboto,Helvetica,Arial,sans-serif;font-size:13px;font-weight:700;letter-spacing:1px;text-transform:uppercase;color:#2563eb;">Что будет дальше</td></tr>
  {% for number, head, body in steps %}
  <tr><td style="padding:12px 24px {{ '22px' if loop.last else '6px' }} 24px;">
    <table role="presentation" width="100%" cellpadding="0" cellspacing="0" border="0"><tr>
      <td width="34" valign="top" style="width:34px;font-family:Inter,-apple-system,'Segoe UI',Roboto,Helvetica,Arial,sans-serif;font-size:20px;line-height:26px;font-weight:700;color:#2563eb;">{{ number }}</td>
      <td valign="top" style="font-family:Inter,-apple-system,'Segoe UI',Roboto,Helvetica,Arial,sans-serif;">
        <div class="ink" style="font-size:16px;line-height:24px;font-weight:600;color:#0f172a;">{{ head }}</div>
        <div class="text" style="font-size:15px;line-height:23px;color:#475569;">{{ body }}</div>
      </td>
    </tr></table>
  </td></tr>
  {% endfor %}
</table>
{% call small() %}Остались вопросы? Просто ответьте на это письмо — мы читаем каждое.{% endcall %}
{% endblock %}
{% block footer_reason %}Вы получили это письмо, потому что оставили заявку на доступ к ALGO на сайте algolab.me.{% endblock %}
