# Auth Service — Environment Variables
# Copy to .env and fill in real values

# App
APP_ENV=development  # development | production | testing
DEBUG=false

# Database — auth service owns only this DB
DATABASE_URL=postgresql://algo:algo_password@localhost:5432/algo_auth

# Redis — session store + rate limiting
REDIS_URL=redis://localhost:6379

# JWT — signing key; min 32 characters; never share this
SECRET_KEY=change-me-in-production-must-be-at-least-32-chars

# JWT token lifetimes
ACCESS_TOKEN_EXPIRE_MINUTES=60
REFRESH_TOKEN_EXPIRE_DAYS=30

# CORS
CORS_ORIGINS=["http://localhost:3000","http://localhost:5001"]

# Optional integrations
GEMINI_API_KEY=
MATHPIX_APP_ID=
MATHPIX_APP_KEY=
SENTRY_DSN=
