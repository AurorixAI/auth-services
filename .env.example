# ============================================================================
# ALGO V1 - Environment Configuration
# ============================================================================
# Скопируйте этот файл в .env и заполните значения

# ============================================================================
# DATABASE
# ============================================================================
DATABASE_URL=postgresql://user:password@localhost:5432/algo_db
DATABASE_POOL_SIZE=10
DATABASE_MAX_OVERFLOW=20

# ============================================================================
# API KEYS
# ============================================================================
# Gemini API (Google AI)
GEMINI_API_KEY=your_gemini_api_key_here

# Mathpix OCR
MATHPIX_APP_ID=your_mathpix_app_id_here
MATHPIX_APP_KEY=your_mathpix_app_key_here

# ============================================================================
# APPLICATION
# ============================================================================
APP_ENV=development  # development, staging, production
DEBUG=true
LOG_LEVEL=INFO

# Server
HOST=0.0.0.0
PORT=8000

# ============================================================================
# DIAGNOSTIC ALGORITHM
# ============================================================================
# Калибровка
CALIBRATION_QUESTIONS=4
CALIBRATION_MIN_IMPORTANCE=8

# Лифт-алгоритм
CONFIDENCE_THRESHOLD=0.85
MAX_ATTEMPTS_PER_SKILL=4
CONFIRMATION_REQUIRED=true

# Deep Scan
DEEP_SCAN_ENABLED=true
MAX_DEEP_SCAN_DEPTH=3

# ============================================================================
# CONTENT PIPELINE
# ============================================================================
# Автоутверждение
AUTO_APPROVE_MIN_CONFIDENCE=0.90
AUTO_APPROVE_MIN_TEMPLATE_QUALITY=0.85
AUTO_APPROVE_REQUIRE_VERIFICATION=true

# Шаблоны
TEMPLATE_STRESS_TEST_ITERATIONS=100

# ============================================================================
# REDIS (SESSION & CACHE)
# ============================================================================
REDIS_URL=redis://localhost:6379/0
REDIS_SESSION_TTL=3600
REDIS_CACHE_TTL=600

# ============================================================================
# SECURITY
# ============================================================================
SECRET_KEY=your_secret_key_here_change_in_production
JWT_SECRET_KEY=your_jwt_secret_key_here
JWT_ALGORITHM=HS256
JWT_ACCESS_TTL_MINUTES=60
JWT_REFRESH_TTL_DAYS=30
ALLOWED_ORIGINS=http://localhost:3000,http://localhost:8080

# ============================================================================
# IRT ENGINE CONFIGURATION
# ============================================================================
IRT_INITIAL_THETA=0.0
IRT_INITIAL_SE=1.0
IRT_CONVERGENCE_THRESHOLD=0.1
IRT_MAX_ITERATIONS=50
IRT_PRIOR_MEAN=0.0
IRT_PRIOR_SD=1.0

# ============================================================================
# SELF-LEARNING GRAPH
# ============================================================================
GRAPH_MIN_SAMPLE_SIZE=30
GRAPH_CORRELATION_THRESHOLD=0.3
GRAPH_UPDATE_BATCH_SIZE=1000
GRAPH_UPDATE_INTERVAL_HOURS=24
