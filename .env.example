# Auth Service — Environment Variables
# Copy to .env and fill in real values

# App
APP_ENV=development  # development | production | testing
DEBUG=false

# Database — auth service owns only this DB
DATABASE_URL=postgresql://algo:algo_password@localhost:5432/algo_auth

# Redis — session store + rate limiting
REDIS_URL=redis://localhost:6379

# JWT — signing key; min 32 characters; never share this
SECRET_KEY=change-me-in-production-must-be-at-least-32-chars

# JWT token lifetimes
ACCESS_TOKEN_EXPIRE_MINUTES=60
REFRESH_TOKEN_EXPIRE_DAYS=30

# CORS
CORS_ORIGINS=["http://localhost:3000","http://localhost:5001"]

# Optional integrations
GEMINI_API_KEY=
MATHPIX_APP_ID=
MATHPIX_APP_KEY=
SENTRY_DSN=
EXAM_SERVICE_URL=http://exam-service:8003/api/v1
# Shared with exam-service only; use a long random value outside local dev.
INTERNAL_SERVICE_TOKEN=

# Password recovery ("Забыли пароль?"). The link in the e-mail opens FRONTEND_URL/reset-password?token=...
# FRONTEND_URL has no default: when empty, the request's Origin is used only if it is one of CORS_ORIGINS.
# Without SMTP_HOST/SMTP_USER/SMTP_PASSWORD no e-mail is sent; the login page says so and an owner/admin
# hands out the link instead (Teachers page -> "Ссылка для нового пароля").
FRONTEND_URL=
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=noreply@algo.kz
