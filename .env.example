# Auth Service — Environment Variables
# Copy to .env and fill in real values

# App
APP_ENV=development  # development | testing | staging | production. staging/production REFUSE to start with an empty, default or <32-char SECRET_KEY
DEBUG=false

# Database — auth service owns only this DB
DATABASE_URL=postgresql://algo:algo_password@localhost:5432/algo_auth

# Redis — session store + rate limiting
REDIS_URL=redis://localhost:6379

# JWT — signing key; min 32 characters; never share this (generate: openssl rand -hex 32).
# The example value below is rejected in staging/production.
SECRET_KEY=change-me-in-production-must-be-at-least-32-chars
# Optional separate key for the JWTs; empty or unset = SECRET_KEY is used.
JWT_SECRET_KEY=

# JWT token lifetimes (the names the service reads)
JWT_ACCESS_TTL_MINUTES=60
JWT_REFRESH_TTL_DAYS=30

# Base of the invite links handed to students; set it in every deployed environment.
DIAGNOSTIC_BASE_URL=http://localhost:3000/d
# true = refuse to start in staging/production when DIAGNOSTIC_BASE_URL is not set (otherwise an error is only logged)
REQUIRE_DIAGNOSTIC_BASE_URL=false

# CORS
CORS_ORIGINS=["http://localhost:3000","http://localhost:5001"]

# Optional integrations
GEMINI_API_KEY=
MATHPIX_APP_ID=
MATHPIX_APP_KEY=
SENTRY_DSN=
EXAM_SERVICE_URL=http://exam-service:8003/api/v1
# Shared with exam-service only; use a long random value outside local dev.
INTERNAL_SERVICE_TOKEN=
