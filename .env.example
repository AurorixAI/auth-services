# Auth Service — Environment Variables
# Copy to .env and fill in real values

# App
APP_ENV=development  # development | testing | staging | production. staging/production REFUSE to start with an empty, default or <32-char SECRET_KEY
DEBUG=false

# Database — auth service owns only this DB
DATABASE_URL=postgresql://algo:algo_password@localhost:5432/algo_auth

# Redis — session store + rate limiting
REDIS_URL=redis://localhost:6379

# JWT — signing key; min 32 characters; never share this (generate: openssl rand -hex 32).
# The example value below is rejected in staging/production.
SECRET_KEY=change-me-in-production-must-be-at-least-32-chars
# Optional separate key for the JWTs; empty or unset = SECRET_KEY is used.
JWT_SECRET_KEY=

# JWT token lifetimes (the names the service reads)
JWT_ACCESS_TTL_MINUTES=60
JWT_REFRESH_TTL_DAYS=30

# Base of the invite links handed to students; set it in every deployed environment.
DIAGNOSTIC_BASE_URL=http://localhost:3000/d
# true = refuse to start in staging/production when DIAGNOSTIC_BASE_URL is not set (otherwise an error is only logged)
REQUIRE_DIAGNOSTIC_BASE_URL=false

# CORS
CORS_ORIGINS=["http://localhost:3000","http://localhost:5001"]

# Optional integrations
GEMINI_API_KEY=
MATHPIX_APP_ID=
MATHPIX_APP_KEY=
SENTRY_DSN=
EXAM_SERVICE_URL=http://exam-service:8003/api/v1
# Shared with exam-service only; use a long random value outside local dev.
INTERNAL_SERVICE_TOKEN=

# Platform console (pack «Консоль-1»)
# Hosts that may use /api/v1/platform/* (Host and X-Forwarded-Host); any other host gets 404. Set ONE host per stack:
#   production: CONSOLE_HOSTS=console.algolab.me
#   stage:      CONSOLE_HOSTS=console.stage.algolab.me
CONSOLE_HOSTS=console.stage.algolab.me
# Links in the letters: «Открыть в консоли» (CONSOLE_URL) and «Задать пароль» (FRONTEND_URL).
#   production: CONSOLE_URL=https://console.algolab.me  FRONTEND_URL=https://app.algolab.me  SITE_URL=https://algolab.me  (K3: the product on app., the landing on the main address)
#   stage:      CONSOLE_URL=https://console.stage.algolab.me  FRONTEND_URL=https://stage.algolab.me  SITE_URL=https://landing.stage.algolab.me
# (localhost here only for local development: a deployed stack logs a WARNING at start-up when these point at localhost.)
CONSOLE_URL=http://localhost:3001
FRONTEND_URL=http://localhost:3000
SITE_URL=https://algolab.me
# true = refuse to start in staging/production when FRONTEND_URL and SITE_URL are one host (otherwise an error is only logged); set it together with the move to app.
REQUIRE_DISTINCT_SITE_HOSTS=false
# Turnstile of the public demo request form (empty = no check; staging/production log a warning)
TURNSTILE_SECRET_KEY=
# hosts of the site the form lives on, comma separated (the hostname of Cloudflare's answer must be one of them; empty = not compared)
TURNSTILE_HOSTNAMES=
ADMIN_NOTIFICATION_EMAIL=
# Letters: From «ALGO <noreply@algolab.me>», Reply-To = the owner's address.
SMTP_FROM_NAME=ALGO
SMTP_FROM=noreply@algolab.me
MAIL_REPLY_TO=
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
# POST /auth/apply is closed (410) by default; false reopens the old self-registration.
SELF_REGISTRATION_CLOSED=true
AUTO_APPROVE_ORGANIZATIONS=false
